				perms = <0x1c>;
			};

			mfgpll {
				fh-id = <0x06>;
				pll-id = <0x09>;
			};

			mpll {
				fh-id = <0x08>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			mmpll {
				fh-id = <0x09>;
				pll-id = <0x07>;
			};

			mainpll {
				fh-id = <0x0a>;
				pll-id = <0x04>;
			};

			msdcpll {
				fh-id = <0x0b>;
				pll-id = <0x06>;
